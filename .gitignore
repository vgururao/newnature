inbox/**/*.pptx
inbox/**/*.key
inbox/**/*.epub
inbox/**/*.png
inbox/**/*.jpg
inbox/**/*.jpeg
inbox/**/*.gif
inbox/**/*.heic
inbox/**/*.webp
inbox/**/*.mp3
inbox/**/*.m4a
inbox/**/*.wav
inbox/**/*.mp4
inbox/**/*.mov
inbox/**/*.zip

# book_meta.json (auto-generated by Publishing Dashboard from status.md; not source)
/book_meta.json

# Print-resolution images stay in Dropbox only (large).
images/print/
